# Address of RoscaCredit.sol after you deploy it to Arc Testnet
NEXT_PUBLIC_ROSCA_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# ERC-20 token used for contributions and staking (a testnet USDC on Arc, or your own test token)
NEXT_PUBLIC_TOKEN_ADDRESS=0xYourTestUSDCAddress

# Get a free client ID at https://thirdweb.com/create-api-key
# This powers Google/email login (embedded wallet) and all contract calls.
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id
