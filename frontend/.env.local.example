# Address of RoscaCredit.sol after you deploy it to Arc Testnet
NEXT_PUBLIC_ROSCA_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# ERC-20 token used for contributions (a testnet USDC on Arc, or your own test token)
NEXT_PUBLIC_TOKEN_ADDRESS=0xYourTestUSDCAddress

# Get a free project ID at https://cloud.walletconnect.com (used by RainbowKit)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
